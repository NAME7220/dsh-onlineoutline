{
  "name": "dsh-onlineoutline",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Scrollable question outline on the right edge of a DeepSeek Harness conversation.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md", "README.zh-CN.md", "LICENSE", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
